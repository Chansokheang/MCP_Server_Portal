# Copy to .env next to docker-compose.yml and adjust. Compose reads it automatically.

# Host name or IP that agents and browsers will use to reach this server.
# Keep 127.0.0.1 for a local run; set the real host in production.
PUBLIC_HOST=127.0.0.1

# Published ports. This server only exposes 9010 to 9020, so stay inside it.
GATEWAY_PORT=9010       # curated MCP gateway, path /mcp
REGISTRY_PORT=9011      # registry gateway for registered APIs, path /mcp
PORTAL_PORT=9012        # onboarding portal web UI
LEGACY_API_PORT=9013    # mock Bizplay API, drop the mapping in production
COOCON_PORT=9016        # COOCON mock scraping API (second demo backend)

# Service token the gateway sends to the mock API, and that the API accepts.
BIZPLAY_API_TOKENS=demo-service-token
